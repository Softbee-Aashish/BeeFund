# ==============================================================================
# BEEFUND - DECENTRO CREDIT BUREAU API CONFIGURATION
# ==============================================================================
#
# IMPORTANT NOTICE:
# - Each live credit bureau call costs ~₹400.
# - DO NOT commit real keys to GitHub. Keep your keys only in .env or .env.local.
# - Test thoroughly in 'staging' environment first before switching to 'production'.
#
# Obtain your credentials from the Decentro Dashboard:
# https://dashboard.decentro.tech/
# ==============================================================================

# Decentro Client Credentials
DECENTRO_CLIENT_ID=your_decentro_client_id_here
DECENTRO_CLIENT_SECRET=your_decentro_client_secret_here
DECENTRO_MODULE_SECRET=your_decentro_module_secret_here

# Environment: 'staging' (Sandbox) or 'production' (Live Bureau - Real Cost)
DECENTRO_ENV=staging

# Preferred Bureau: 'EQ' (Equifax - default), 'EX' (Experian), or 'CR' (CRIF)
DECENTRO_BUREAU_CODE=EQ

# Safe Mode / Mock Mode Toggle:
# Set to 'true' to use realistic simulated bureau data with ZERO cost (₹0 hit).
# Set to 'false' to route requests to the live Decentro API endpoint.
VITE_DECENTRO_MOCK_MODE=true
